{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "model_fallback": true,
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      429,
      500,
      502,
      503,
      504,
      529
    ],
    "retry_on_timeout": true,
    "retry_on_network_error": true,
    "max_fallback_attempts": 5,
    "backoff_ms": 1000,
    "max_backoff_ms": 30000,
    "timeout_seconds": 120,
    "cooldown_seconds": 30
  },
  "providerOptions": {
    "enable-auto-tool-choice": true,
    "tool-call-parser": "auto"
  },
  "provider": {
    "openrouter": {
      "timeout": 120000,
      "chunkTimeout": 30000,
      "options": {
        "timeout": 120000,
        "chunkTimeout": 30000
      },
      "models": {
        "mistralai/mistral-nemo": {
          "name": "Mistral Nemo",
          "limit": {
            "context": 131072,
            "output": 4096
          }
        },
        "ibm-granite/granite-4.0-h-micro": {
          "name": "IBM Granite 4.0 H Micro",
          "limit": {
            "context": 131072,
            "output": 4096
          }
        },
        "meta-llama/llama-3.1-8b-instruct": {
          "name": "Meta Llama 3.1 8B Instruct",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "google/gemini-2.5-flash-lite": {
          "name": "Google Gemini 2.5 Flash Lite",
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        },
        "qwen/qwen3-vl-32b-instruct": {
          "name": "Qwen3 VL 32B Instruct",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "google/gemini-2.5-flash": {
          "name": "Google Gemini 2.5 Flash",
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        }
      }
    }
  },
  "background_task": {
    "staleTimeoutMs": 60000,
    "circuitBreaker": {
      "enabled": true,
      "consecutiveThreshold": 50,
      "maxToolCalls": 8000
    }
  },
  "agents": {
    "sisyphus": {
      "model": "openrouter/mistralai/mistral-nemo",
      "provider": "openrouter",
      "variant": "max",
      "reasoningEffort": "xhigh",
      "temperature": 0.3,
      "top_p": 0.9,
      "maxTokens": 16384,
      "thinking": {
        "type": "enabled",
        "budgetTokens": 10000
      },
      "mode": "primary",
      "category": "orchestrator",
      "skills": [
        "ralph",
        "autopilot",
        "ultrawork"
      ],
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true,
        "task": true,
        "webfetch": true,
        "websearch": true
      },
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "task": "allow"
      },
      "textVerbosity": "medium",
      "color": "#9400D3",
      "fallback_models": [
        "openrouter/ibm-granite/granite-4.0-h-micro",
        "openrouter/meta-llama/llama-3.1-8b-instruct"
