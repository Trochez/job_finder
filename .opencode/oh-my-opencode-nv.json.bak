{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "model_fallback": true,
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      429,
      500,
      502,
      503,
      504,
      529
    ],
    "retry_on_timeout": true,
    "retry_on_network_error": true,
    "max_fallback_attempts": 5,
    "backoff_ms": 1000,
    "max_backoff_ms": 30000,
    "timeout_seconds": 120,
    "cooldown_seconds": 30
  },
  "providerOptions": {
    "enable-auto-tool-choice": true,
    "tool-call-parser": "auto"
  },
  "provider": {
    "nvidia": {
      "timeout": 120000,
      "chunkTimeout": 30000
    },
    "openai": {
      "timeout": 120000,
      "chunkTimeout": 30000,
      "options": {
        "timeout": 120000,
        "chunkTimeout": 30000
      },
      "models": {
        "gpt-5": {
          "name": "Gpt 5"
        },
        "gpt-5-mini": {
          "name": "Gpt 5 Mini"
        },
        "gpt-5.4": {
          "name": "Gpt 5.4"
        },
        "gpt-5.4-mini": {
          "name": "Gpt 5.4 Mini"
        },
        "gpt-5.4-nano": {
          "name": "Gpt 5.4 Nano"
        },
        "gpt-5.4-pro": {
          "name": "Gpt 5.4 Pro"
        },
        "gpt-5.5": {
          "name": "Gpt 5.5"
        },
        "gpt-5.5-pro": {
          "name": "Gpt 5.5 Pro"
        }
      }
    },
    "opencode": {
      "timeout": 120000,
      "chunkTimeout": 30000
    }
  },
  "background_task": {
    "staleTimeoutMs": 60000,
    "circuitBreaker": {
      "enabled": true,
      "consecutiveThreshold": 50,
      "maxToolCalls": 8000
    }
  },
  "agents": {
    "sisyphus": {
      "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
