{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "overleaf": {
      "type": "local",
      "command": ["npx", "-y", "@mjyoo2/overleafmcp"],
      "enabled": true,
      "environment": {
        "OVERLEAF_PROJECT_ID": "TU_PROJECT_ID_DE_OVERLEAF",
        "OVERLEAF_GIT_TOKEN": "TU_GIT_TOKEN_DE_OVERLEAF"
      }
    },
    "linkedin": {
      "type": "local",
      "command": ["uvx", "mcp-server-linkedin@latest"],
      "enabled": true,
      "environment": {
        "UV_HTTP_TIMEOUT": "300"
      }
    }
  }
}
