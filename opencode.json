{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "overleaf": {
      "type": "local",
      "command": ["npx", "-y", "@mjyoo2/overleafmcp"],
      "enabled": true,
      "_comment": "Credentials managed via PrivateSettings (token file on disk, 0o600). See opencode.PrivateSettings for path configuration."
    },
    "linkedin": {
      "type": "local",
      "command": ["uvx", "mcp-server-linkedin@latest"],
      "enabled": true,
      "environment": {
        "UV_HTTP_TIMEOUT": "300"
      }
    }
  }
}
